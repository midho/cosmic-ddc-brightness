[Unit]
Description=External display brightness controller for COSMIC
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cosmic-ddc-brightness daemon
Restart=on-failure
RestartSec=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
